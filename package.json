{
  "name": "dsh-xiangxu-persona",
  "version": "0.6.0",
  "type": "module",
  "description": "Portable long-term persona and memory for DSH, with autonomous isolated tasks, complete task archives, QR chat channels and optional reference-based media",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./adapters/dsh/index.js",
    "./core": "./core/index.js",
    "./client": "./ui/client.js",
    "./dsh-channel": "./adapters/dsh/channels/native.js",
    "./speech": "./adapters/dsh/channels/windows-speech.js",
    "./media": "./adapters/dsh/media/index.js",
    "./connections": "./adapters/dsh/connections/service.js",
    "./delegation": "./adapters/dsh/delegation/service.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.mjs",
    "test:host": "node scripts/dsh-integration.mjs",
    "build": "node scripts/build-ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MingoYung/dsh-Xiangxu-Persona.git"
  },
  "homepage": "https://github.com/MingoYung/dsh-Xiangxu-Persona",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "persona",
    "memory",
    "xiangxu"
  ],
  "files": [
    "core",
    "adapters/dsh/index.js",
    "adapters/dsh/control.js",
    "adapters/dsh/instances.js",
    "adapters/dsh/management.js",
    "adapters/dsh/ui-host.js",
    "adapters/dsh/normalize.js",
    "adapters/dsh/model.js",
    "adapters/dsh/tool-schema.js",
    "adapters/dsh/tool-output.js",
    "adapters/dsh/voice.js",
    "adapters/dsh/surfaces.js",
    "adapters/dsh/permissions.js",
    "adapters/dsh/companion-scope.js",
    "adapters/dsh/delegation",
    "adapters/dsh/owner-assets.js",
    "adapters/dsh/login-qr.js",
    "adapters/dsh/qr.js",
    "adapters/dsh/connections",
    "adapters/dsh/media",
    "adapters/dsh/vendor",
    "adapters/dsh/channels",
    "ui/index.html",
    "ui/app.js",
    "ui/style.css",
    "ui/client.js",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "market"
  ]
}
